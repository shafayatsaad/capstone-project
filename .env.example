# Copy this file to .env for local development. Never commit .env.
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET=replace-with-a-random-secret-before-sharing
JWT_TTL_MINUTES=60
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=*
MAX_PAYLOAD_BYTES=10000
MAX_FIELDS=20
MAX_FIELD_LENGTH=2000
RATE_LIMIT_SUBMISSIONS=20/minute
GEO_MODE=mock
MOCK_PROVIDER_A_UP=true
MOCK_PROVIDER_B_UP=true
GEO_TIMEOUT_SECONDS=2
FORCE_NOTIFY_FAIL=false
HONEYPOT_FIELD_NAME=hp_field
